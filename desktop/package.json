{
  "name": "chat-app-desktop",
  "version": "1.4.4",
  "description": "Chat App",
  "author": "Chat App",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "adm-zip": "0.5.16"
  },
  "devDependencies": {
    "electron": "44.4.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.chatapp.desktop",
    "productName": "Chat App",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "*.cjs",
      "helpers/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json",
      "spotify-config.json",
      {
        "from": "../unread-icons",
        "to": "assets/unread",
        "filter": [
          "*.png"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "bundled-app",
        "filter": [
          "**/*",
          "!desktop{,/**/*}",
          "!node_modules{,/**/*}",
          "!tests{,/**/*}",
          "!backend/functions/node_modules{,/**/*}",
          "!test-results{,/**/*}",
          "!unread-icons{,/**/*}",
          "!.git{,/**/*}"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/chat-app.ico"
    },
    "portable": {
      "artifactName": "Chat App.exe"
    }
  }
}
